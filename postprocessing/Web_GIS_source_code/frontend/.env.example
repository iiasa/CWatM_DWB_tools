# Backend Configuration
REACT_APP_BACKEND_URL=http://localhost:8085
REACT_APP_API_BASE_URL=http://localhost:8085

# Application Configuration
REACT_APP_APP_NAME=DWB
REACT_APP_VERSION=1.0.0
REACT_APP_ENVIRONMENT=development

# Map Tile URLs
REACT_APP_GOOGLE_SATELLITE_URL=https://mt1.google.com/vt/lyrs=s&x={x}&y={y}&z={z}
REACT_APP_OSM_TILE_URL=https://a.tile.openstreetmap.org/{z}/{x}/{y}.png

# Map Default Settings
REACT_APP_MIN_ZOOM=2
REACT_APP_MAX_ZOOM=19

# TiTiler Configuration (on-the-fly raster tile server)
REACT_APP_TITILER_URL=http://localhost:8090
