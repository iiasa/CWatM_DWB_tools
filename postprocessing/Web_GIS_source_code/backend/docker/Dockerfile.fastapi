FROM python:3.11-slim

# System dependencies for HDF5 / NetCDF
RUN apt-get update && apt-get install -y --no-install-recommends \
    libhdf5-dev \
    libnetcdf-dev \
    curl \
    && rm -rf /var/lib/apt/lists/*

WORKDIR /app

# Install Python dependencies
COPY python/requirements-fastapi.txt requirements.txt
RUN pip install --no-cache-dir -r requirements.txt

# Copy the FastAPI service
COPY python/fastapi_service.py fastapi_service.py

# Non-root user
RUN groupadd -r dwb && useradd -r -g dwb dwb
USER dwb

ENV HDF5_USE_FILE_LOCKING=FALSE
ENV WORKERS=2

EXPOSE 8086

HEALTHCHECK --interval=15s --timeout=10s --start-period=30s --retries=3 \
    CMD curl -f http://localhost:8086/health || exit 1

CMD ["sh", "-c", "uvicorn fastapi_service:app --host 0.0.0.0 --port 8086 --workers ${WORKERS}"]
