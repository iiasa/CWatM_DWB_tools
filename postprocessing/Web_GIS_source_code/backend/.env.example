# Server Configuration
NODE_ENV=development
PORT=8085

# Frontend Configuration
FRONTEND_URL=http://localhost:3000

# Database Configuration
DATABASE_HOST=localhost
DATABASE_PORT=5432
DATABASE_USERNAME=postgres
DATABASE_PASSWORD=your-database-password
DATABASE_NAME=DWB

# JWT Configuration
JWT_SECRET=your-secret-key-here-change-in-production
JWT_EXPIRES_IN=24h

# Redis Configuration
REDIS_URL=redis://localhost:6379

# Data Directories
# Absolute path to the data directory containing stations/, subbasins/, nc/, tif/
# Default (if unset): Python scripts resolve to ../../data relative to backend/python/
# For VM deployment, set to absolute path e.g. /opt/dwb/data
# DATA_DIR=/opt/dwb/data
DATASETS_DIR=./data/datasets
RESULTS_DIR=./data/results
MANIFEST_PATH=./data/manifest.json

# Cache Configuration
CACHE_TTL_SECONDS=2592000
STATUS_TTL_SECONDS=86400

# Performance & Scaling
# Number of Node.js cluster workers (default: number of CPU cores, max: CPU count)
# Set to 1 to disable clustering
CLUSTER_WORKERS=4
# Max concurrent Python subprocesses across all workers (default: 6)
MAX_PYTHON_PROCESSES=6
# Dask thread workers for NetCDF parallel processing (default: auto = CPU cores)
DASK_NUM_WORKERS=4

# Point Graph API (FastAPI sidecar for fast NetCDF point queries)
# Use http://point-graph-api:8086 inside Docker Compose (set in docker-compose.yml)
POINT_GRAPH_API_URL=http://localhost:8086

# TiTiler Configuration (on-the-fly raster tile server)
# Internal URL used by backend to proxy point queries (Docker network)
TITILER_INTERNAL_URL=http://titiler:8000
# Public URL served to frontend for direct tile fetching
TITILER_PUBLIC_URL=http://localhost:8090
# Host port for TiTiler container
TITILER_PORT=8090
# Host directory containing COG files
COG_DIR_HOST=../data/tif/cog
